datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Song {
  id      Int    @id @default(autoincrement())
  title   String
  artist  String
  album   Album? @relation(references: [id], fields: [albumId])
  albumId Int?
}

model Album {
  id     Int    @id @default(autoincrement())
  title  String
  artist String
  songs  Song[]
}
